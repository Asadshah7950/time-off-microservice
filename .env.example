# Application
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300

# Database
DB_PATH=./data/timeoff.db

# HCM Integration
HCM_BASE_URL=http://localhost:3001
HCM_TIMEOUT_MS=5000
HCM_CIRCUIT_BREAKER_THRESHOLD=5
HCM_CIRCUIT_BREAKER_RESET_MS=30000
HCM_RETRY_MAX_ATTEMPTS=3
HCM_RETRY_BASE_DELAY_MS=1000

# Balance
BALANCE_STALE_THRESHOLD_HOURS=6
IDEMPOTENCY_TTL_HOURS=24

# Sync Schedule (cron expression)
BATCH_SYNC_CRON=0 2 * * *
HCM_PENDING_RETRY_CRON=*/15 * * * *
