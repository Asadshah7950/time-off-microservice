{
  "name": "timeoff-service",
  "version": "1.0.0",
  "description": "Production-grade Time-Off Microservice with HCM sync, idempotency, and concurrency control",
  "main": "src/main.js",
  "scripts": {
    "start": "node -r @babel/register src/main.js",
    "start:dev": "nodemon --exec \"node -r @babel/register src/main.js\" --watch src --ext js",
    "start:mock-hcm": "node mock-hcm/src/server.js",
    "test": "node -r @babel/register ./node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:unit": "node -r @babel/register ./node_modules/jest/bin/jest.js --testPathPattern=\"test/unit\" --runInBand --forceExit",
    "test:integration": "node -r @babel/register ./node_modules/jest/bin/jest.js --testPathPattern=\"test/integration\" --runInBand --forceExit",
    "test:e2e": "node -r @babel/register ./node_modules/jest/bin/jest.js --testPathPattern=\"test/e2e\" --runInBand --forceExit",
    "test:coverage": "node -r @babel/register ./node_modules/jest/bin/jest.js --coverage --runInBand --forceExit"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schedule": "^4.0.1",
    "@nestjs/typeorm": "^10.0.2",
    "axios": "^1.6.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.0",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.20",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/node": "^7.23.9",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@babel/register": "^7.23.7",
    "@nestjs/testing": "^10.3.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4"
  }
}
